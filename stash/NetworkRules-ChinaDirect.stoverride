name: 'Network Rules - China Direct'
desc: '广告拦截和国内直连；其他流量沿用主配置'
homepage: 'https://github.com/inderiva/network-rules-dist'
rule-providers:
  geosite-category-ads-all-domain:
    behavior: domain
    format: yaml
    path: ./rules/network-rules-dist-v2/geosite-category-ads-all-domain.yaml
    url: https://raw.githubusercontent.com/inderiva/network-rules-dist/release/stash/rules/geosite-category-ads-all-domain.yaml
    interval: 86400
  geosite-category-ads-all-classical:
    behavior: classical
    format: yaml
    path: ./rules/network-rules-dist-v2/geosite-category-ads-all-classical.yaml
    url: https://raw.githubusercontent.com/inderiva/network-rules-dist/release/stash/rules/geosite-category-ads-all-classical.yaml
    interval: 86400
  geosite-cn-domain:
    behavior: domain
    format: yaml
    path: ./rules/network-rules-dist-v2/geosite-cn-domain.yaml
    url: https://raw.githubusercontent.com/inderiva/network-rules-dist/release/stash/rules/geosite-cn-domain.yaml
    interval: 86400
  geosite-cn-classical:
    behavior: classical
    format: yaml
    path: ./rules/network-rules-dist-v2/geosite-cn-classical.yaml
    url: https://raw.githubusercontent.com/inderiva/network-rules-dist/release/stash/rules/geosite-cn-classical.yaml
    interval: 86400
  geoip-cn:
    behavior: ipcidr
    format: yaml
    path: ./rules/network-rules-dist-v2/geoip-cn.yaml
    url: https://raw.githubusercontent.com/inderiva/network-rules-dist/release/stash/rules/geoip-cn.yaml
    interval: 86400
rules:
  - RULE-SET,geosite-category-ads-all-domain,REJECT
  - RULE-SET,geosite-category-ads-all-classical,REJECT
  - RULE-SET,geosite-cn-domain,DIRECT
  - RULE-SET,geosite-cn-classical,DIRECT
  - RULE-SET,geoip-cn,DIRECT
