#!name=Network Rules
#!desc=轻量引用广告拦截与国内直连规则集
#!homepage=https://github.com/inderiva/network-rules-dist

[Rule]
# 省略 9 条 Shadowrocket 不兼容的 DOMAIN-REGEX。

# 广告拒绝
DOMAIN-SET,https://raw.githubusercontent.com/inderiva/network-rules-dist/main/shadowrocket/rules/geosite-category-ads-all-domain.list,REJECT

# 国内直连
DOMAIN-SET,https://raw.githubusercontent.com/inderiva/network-rules-dist/main/shadowrocket/rules/geosite-cn-domain.list,DIRECT
RULE-SET,https://raw.githubusercontent.com/inderiva/network-rules-dist/main/shadowrocket/rules/geoip-cn.list,DIRECT
